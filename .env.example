# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.5-flash now 404s for projects created after ~2026-06. Alternatives:
#   gemini-3.1-flash-lite   500 requests/day; enough for the 108-call experiment
#   gemini-3-flash-preview  higher; answers 503 when busy - the harness retries
GEMINI_MODEL=gemini-3.1-flash-lite

# 0 = deterministic. Keep it at 0 so the three iterations stay comparable:
# without it, the deltas in results/summary.csv measure sampling noise.
GEMINI_TEMPERATURE=0

# -1 = send no thinking config (the default; every model accepts this)
#  0 = thinking off, on models that support switching it off
# >0 = thinking token budget
# Reasoning models spend output tokens thinking before writing a character. Under
# a low max_output_tokens that returns an empty answer rather than an error.
GEMINI_THINKING_BUDGET=-1
GEMINI_MAX_OUTPUT_TOKENS=512

# Requests per minute, paced process-wide by llm.RateLimiter. Exceeding the free
# tier returns 429, and a 429 scores 0 - which silently poisons the experiment.
GEMINI_RPM=10

# ---------------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------------
# cmd | powershell | bash
DEFAULT_SHELL=cmd

# Which prompt iteration the Gradio app opens with: v1 | v2 | v3
DEFAULT_PROMPT_VERSION=v3

# true  -> every del / rm / Remove-Item is BLOCKED outright (the literal reading
#          of the assignment's forbidden list).
# false -> scoped deletes (del downloads\*.tmp) are RISKY and need confirmation;
#          only unbounded or system-scope deletes are BLOCKED. See docs/ITERATIONS.md.
SAFETY_STRICT_DELETE=false

# ---------------------------------------------------------------------------
# Docker sandbox (bonus task)
# ---------------------------------------------------------------------------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=cli-agent-sandbox:latest
SANDBOX_TIMEOUT_SEC=10
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
# Keep this false. The container runs with --network none unless you flip it.
SANDBOX_ALLOW_NETWORK=false

# ---------------------------------------------------------------------------
# Evaluation harness
# ---------------------------------------------------------------------------
EVAL_WORKERS=4
